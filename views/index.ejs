    Aplikacja do demonstracji ataków XSS
  </h1>

  <dl class="mt-10 border-t border-slate-200 pt-6 dark:border-slate-800">
    <dt class="text-xs font-semibold uppercase tracking-widest text-slate-500">Autorzy</dt>
    <dd class="mt-3 flex flex-col gap-1 text-slate-700 dark:text-slate-300">
      <% for (const name of authors) { %>
        <span><%= name %></span>
      <% } %>
    </dd>
  </dl>
</section>

<%- include('partials/footer') %>
